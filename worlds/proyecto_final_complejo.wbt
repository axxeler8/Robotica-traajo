WorldInfo {
  info [
    "Proyecto Final: Navegación Autónoma con A*"
    "Escenario Complejo — muros zigzag + bloques"
    "ICI 4150 — Robótica y Sistemas Autónomos 2026-01"
  ]
  title "Proyecto Final - Escenario Complejo"
  basicTimeStep 32
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.094
  position 0 0 3.0
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 2 2
  floorTileSize 0.5 0.5
  wallHeight 0.1
}

# ── Marcador de INICIO (disco azul) ────────────────────────────
DEF START Transform {
  translation -0.75 -0.75 0.001
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.3 0.9
        emissiveColor 0 0.1 0.4
        roughness 0.3
      }
      geometry Cylinder {
        height 0.002
        radius 0.06
      }
    }
  ]
}

# ── Marcador de META (disco verde) ─────────────────────────────
DEF GOAL Transform {
  translation 0.75 0.75 0.001
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.85 0.2
        emissiveColor 0 0.35 0.05
        roughness 0.3
      }
      geometry Cylinder {
        height 0.002
        radius 0.06
      }
    }
  ]
}

# ── Robot e-puck ───────────────────────────────────────────────
E-puck {
  translation -0.75 -0.75 0
  rotation 0 0 1 1.5708
  name "e-puck"
  controller "proyecto_final_controller"
  customData "complejo"
}

