EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/gctronic/e-puck/protos/E-puck.proto"

WorldInfo {
  info [
    "Laboratorio 2: Escenario COMPLEJO - pasillo en Z con aperturas"
    "Navegacion reactiva con filtrado y fusion de sensores"
    "ICI 4150 - Robotica y Sistemas Autonomos"
  ]
  title "Lab2 - Escenario Complejo"
  basicTimeStep 32
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.094
  position 0 0 1.5
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 1 1
  wallHeight 0.05
}
E-puck {
  translation -0.42 -0.22 0
  rotation 0 0 1 0
  name "e-puck"
  controller "lab2_controller"
  customData "complex"
}

# ============================================================
# ESCENARIO COMPLEJO: Pasillo en Z con aperturas
# Arena 1x1 m. Corredor de 16 cm con dos giros y aperturas
# explicitas para evitar bloqueos en las esquinas.
# ============================================================

# === TRAMO 1: horizontal inferior ===
# Limites y=-0.30 (abajo) y y=-0.14 (arriba)
Solid {
  translation -0.28 -0.30 0.025
  name "wall_h1_bottom"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.45 0.45 0.50
        roughness 0.6
        metalness 0.0
      }
      geometry Box {
        size 0.34 0.02 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.34 0.02 0.05
  }
}
Solid {
  translation -0.28 -0.14 0.025
  name "wall_h1_top"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.45 0.45 0.50
        roughness 0.6
        metalness 0.0
      }
      geometry Box {
        size 0.34 0.02 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.34 0.02 0.05
  }
}

# === TRAMO 2: vertical (con apertura inferior) ===
# Limites x=-0.12 (izq) y x=0.04 (der)
Solid {
  translation 0.04 0.02 0.025
  name "wall_v_right"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.45 0.45 0.50
        roughness 0.6
        metalness 0.0
      }
      geometry Box {
        size 0.02 0.32 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.02 0.32 0.05
  }
}
