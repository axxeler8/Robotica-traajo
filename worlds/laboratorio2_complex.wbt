# === Obstaculos internos (pilares) ===
Solid {
  translation -0.25 -0.22 0.025
  name "pillar_1"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.6 0.1
        roughness 0.3
        metalness 0.0
      }
      geometry Cylinder {
        height 0.05
        radius 0.02
      }
    }
  ]
  boundingObject Cylinder {
    height 0.05
    radius 0.02
  }
}
