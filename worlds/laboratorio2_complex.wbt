#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/gctronic/e-puck/protos/E-puck.proto"

WorldInfo {
  info [
    "Laboratorio 2: Escenario COMPLEJO - pasillo estrecho y múltiples obstáculos"
    "Navegación reactiva con filtrado y fusión de sensores"
    "ICI 4150 - Robótica y Sistemas Autónomos"
  ]
  title "Lab2 - Escenario Complejo"
  basicTimeStep 32
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.094
  position 0 0 2.5
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 2 2
  wallHeight 0.05
}
E-puck {
  translation 0 0 0
  rotation 0 0 1 0
  name "e-puck"
  controller "lab2_controller"
  customData "complex"
}

# ============================================================
# ESCENARIO COMPLEJO: Pasillo de 18 cm con 5 obstaculos
# Paredes a y=±0.09 → corredor de 18 cm (robot 7 cm → 5.5 cm
# de holgura a cada lado). Obstaculos escalonados dentro del
# pasillo, con espacio suficiente para que el robot maniobre.
# NOTA: Sensores IR del e-puck tienen rango maximo ~5 cm.
# ============================================================

# --- Pared izquierda del pasillo (y = -0.09) ---
Solid {
  translation 0.27 -0.09 0.025
  name "wall_left"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.5 0.5 0.5
        roughness 0.6
      }
      geometry Box {
        size 0.55 0.02 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.55 0.02 0.05
  }
}

# --- Pared derecha del pasillo (y = +0.09) ---
Solid {
  translation 0.27 0.09 0.025
  name "wall_right"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.5 0.5 0.5
        roughness 0.6
      }
      geometry Box {
        size 0.55 0.02 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.55 0.02 0.05
  }
}

# --- Obstaculo 1: Cilindro centrado (a 12 cm) ---
Solid {
  translation 0.12 0 0.025
  name "obs1_center"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.6 0.1
        roughness 0.3
      }
      geometry Cylinder {
        height 0.05
        radius 0.02
      }
    }
  ]
  boundingObject Cylinder {
    height 0.05
    radius 0.02
  }
}

# --- Obstaculo 2: Caja a la derecha (a 22 cm) ---
Solid {
  translation 0.22 0.04 0.025
  name "obs2_right"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.3 0.1
        roughness 0.3
      }
      geometry Box {
        size 0.03 0.03 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.03 0.03 0.05
  }
}

# --- Obstaculo 3: Caja a la izquierda (a 32 cm) ---
Solid {
  translation 0.32 -0.05 0.025
  name "obs3_left"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.2 0.8
        roughness 0.4
      }
      geometry Box {
        size 0.03 0.03 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.03 0.03 0.05
  }
}

# --- Obstaculo 4: Cilindro centrado (a 42 cm) ---
Solid {
  translation 0.42 0 0.025
  name "obs4_center"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.7 0.2
        roughness 0.4
      }
      geometry Cylinder {
        height 0.05
        radius 0.025
      }
    }
  ]
  boundingObject Cylinder {
    height 0.05
    radius 0.025
  }
}

# --- Obstaculo 5: Caja al final (a 50 cm, desplazada derecha) ---
Solid {
  translation 0.50 0.03 0.025
  name "obs5_end"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.7 0.2 0.7
        roughness 0.4
      }
      geometry Box {
        size 0.04 0.04 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.04 0.04 0.05
  }
}
