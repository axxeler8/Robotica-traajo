# --- Pilar final (salida alternativa) ---
Solid {
  translation 0.32 0.18 0.025
  name "zona3_pilar_salida"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.25 0.80 0.40
        roughness 0.25
        metalness 0.10
      }
      geometry Cylinder {
        height 0.05
