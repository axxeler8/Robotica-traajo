#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/gctronic/e-puck/protos/E-puck.proto"

WorldInfo {
  info [
    "Laboratorio 2: Escenario COMPLEJO - pasillo con chicanas"
    "Navegacion reactiva con filtrado y fusion de sensores"
    "ICI 4150 - Robotica y Sistemas Autonomos"
  ]
  title "Lab2 - Escenario Complejo"
  basicTimeStep 32
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.094
  position 0 0 1.5
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 1 1
  wallHeight 0.05
}
E-puck {
  translation -0.40 0 0
  rotation 0 0 1 0
  name "e-puck"
  controller "lab2_controller"
  customData "complex"
}

# ============================================================
# ESCENARIO COMPLEJO: Pasillo estrecho con chicanas (slalom)
# Arena 1x1 m. Paredes laterales forman un corredor de 20 cm.
# Dentro del corredor hay muros alternados que obligan al robot
# a hacer zigzag. Esto fuerza detecciones frontales y laterales,
# demostrando la evasion de obstaculos en pasillos estrechos.
# E-puck: ~7 cm diametro; sensores IR rango ~5 cm.
# ============================================================

# === PAREDES DEL CORREDOR (y = -0.10 e y = +0.10) ===
# Corredor de 20 cm de ancho (robot 7 cm → ~6.5 cm holgura por lado)

# --- Pared superior larga ---
Solid {
  translation 0.0 0.10 0.025
  name "wall_top"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.45 0.45 0.50
        roughness 0.6
        metalness 0.0
      }
      geometry Box {
        size 0.90 0.02 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.90 0.02 0.05
  }
}

# --- Pared inferior larga ---
Solid {
  translation 0.0 -0.10 0.025
  name "wall_bottom"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.45 0.45 0.50
        roughness 0.6
        metalness 0.0
      }
      geometry Box {
        size 0.90 0.02 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.90 0.02 0.05
  }
}

# === CHICANAS: Muros alternados dentro del corredor ===
# Cada chicana bloquea ~50% del ancho del pasillo, dejando ~10 cm
# de espacio libre (robot 7 cm → ~1.5 cm de margen por lado).

# --- Chicana 1: Sale de la pared inferior, bloquea paso central-abajo ---
# Deja paso libre arriba (y > 0)
Solid {
  translation -0.24 -0.05 0.025
  name "chicane_1"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.3 0.2
        roughness 0.3
        metalness 0.0
      }
      geometry Box {
        size 0.02 0.12 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.02 0.12 0.05
  }
}

# --- Chicana 2: Sale de la pared superior, bloquea paso central-arriba ---
# Deja paso libre abajo (y < 0)
Solid {
  translation -0.08 0.05 0.025
  name "chicane_2"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.5 0.9
        roughness 0.3
        metalness 0.0
      }
      geometry Box {
        size 0.02 0.12 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.02 0.12 0.05
  }
}

# --- Chicana 3: Sale de la pared inferior ---
# Deja paso libre arriba
Solid {
  translation 0.08 -0.05 0.025
  name "chicane_3"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.7 0.1
        roughness 0.3
        metalness 0.0
      }
      geometry Box {
        size 0.02 0.12 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.02 0.12 0.05
  }
}

# --- Chicana 4: Sale de la pared superior ---
# Deja paso libre abajo
Solid {
  translation 0.24 0.05 0.025
  name "chicane_4"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.8 0.3
        roughness 0.3
        metalness 0.0
      }
      geometry Box {
        size 0.02 0.12 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.02 0.12 0.05
  }
}

# --- Chicana 5: Sale de la pared inferior (ultima) ---
# Deja paso libre arriba hacia la salida del corredor
Solid {
  translation 0.38 -0.05 0.025
  name "chicane_5"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.7 0.2 0.7
        roughness 0.3
        metalness 0.0
      }
      geometry Box {
        size 0.02 0.12 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.02 0.12 0.05
  }
}
