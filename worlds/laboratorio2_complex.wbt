# ===== PASILLO CENTRAL (chicane) =====
# Pared izquierda del pasillo - tramo 1
Solid {
  translation -0.06 0.0 0.025
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.6 0.6 0.6
        roughness 0.8
        metalness 0
      }
      geometry Box {
        size 0.01 0.20 0.05
      }
    }
  ]
  name "corridor_L1"
  boundingObject Box {
    size 0.01 0.20 0.05
  }
}
