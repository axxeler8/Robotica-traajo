WorldInfo {
  info [
    "Laboratorio 2: Escenario COMPLEJO - pasillo con chicanas abiertas"
    "Navegacion reactiva con filtrado y fusion de sensores"
    "ICI 4150 - Robotica y Sistemas Autonomos"
  ]
  title "Lab2 - Escenario Complejo"
  basicTimeStep 32
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.094
  position 0 0 1.5
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 1 1
  wallHeight 0.05
}
E-puck {
  translation -0.42 0 0
  rotation 0 0 1 0
  name "e-puck"
  controller "lab2_controller"
  customData "complex"
}

# ============================================================
# ESCENARIO COMPLEJO: Pasillo con chicanas abiertas
# Arena 1x1 m. Corredor de 22 cm con chicanas alternadas.
# El inicio queda libre para que el robot no se trabe.
# ============================================================

# === PAREDES DEL CORREDOR (y = -0.11 e y = +0.11) ===
Solid {
  translation 0.0 0.11 0.025
  name "wall_top"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.45 0.45 0.50
        roughness 0.6
        metalness 0.0
      }
      geometry Box {
        size 0.90 0.02 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.90 0.02 0.05
  }
}
Solid {
  translation 0.0 -0.11 0.025
  name "wall_bottom"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.45 0.45 0.50
        roughness 0.6
        metalness 0.0
      }
      geometry Box {
        size 0.90 0.02 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.90 0.02 0.05
  }
}

