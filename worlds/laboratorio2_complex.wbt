#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/gctronic/e-puck/protos/E-puck.proto"

WorldInfo {
  info [
    "Laboratorio 2: Escenario COMPLEJO - laberinto progresivo"
    "Navegacion reactiva con filtrado y fusion de sensores"
    "ICI 4150 - Robotica y Sistemas Autonomos"
  ]
  title "Lab2 - Escenario Complejo: Laberinto Progresivo"
  basicTimeStep 32
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.094
  position 0 0 1.5
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 1 1
  wallHeight 0.05
}
E-puck {
  translation -0.44 0 0
  rotation 0 0 1 0
  name "e-puck"
  controller "lab2_controller"
  customData "complex"
}

# ============================================================
# ESCENARIO COMPLEJO: Laberinto Progresivo (3 zonas)
# Arena 1x1 m. Robot en (-0.44, 0) mirando +X.
# El corredor se divide en tres zonas de dificultad creciente:
#   Zona 1 (x=-0.44 a -0.05): Corredor amplio (24 cm), pilar central
#   Zona 2 (x=-0.05 a 0.30):  Corredor medio (18 cm), obstaculos alternados
#   Zona 3 (x= 0.30 a 0.44):  Corredor estrecho (14 cm), giro forzado
# Diseñado para mostrar adaptacion del Kalman a condiciones cambiantes.
# ============================================================

# === PAREDES EXTERIORES (guian todo el recorrido) ===
# --- Pared superior (larga, hasta la zona 2) ---
Solid {
  translation -0.08 0.12 0.025
  name "wall_top_main"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.40 0.40 0.45
        roughness 0.5
        metalness 0.1
      }
      geometry Box {
        size 0.72 0.02 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.72 0.02 0.05
  }
}

# --- Pared inferior (larga) ---
Solid {
  translation -0.08 -0.12 0.025
  name "wall_bottom_main"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.40 0.40 0.45
        roughness 0.5
        metalness 0.1
      }
      geometry Box {
        size 0.72 0.02 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.72 0.02 0.05
  }
}

# === ZONA 1: Corredor amplio (24 cm) + pilar central ===
Solid {
  translation -0.28 0.0 0.025
  name "zona1_pilar"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.90 0.60 0.10
        roughness 0.25
        metalness 0.10
      }
      geometry Cylinder {
        height 0.05
        radius 0.03
      }
    }
  ]
  boundingObject Cylinder {
    height 0.05
    radius 0.03
  }
}

# === ZONA 2: Corredor medio (18 cm) + obstaculos ===
# --- Estrechamiento: pared superior baja a y=0.09 ---
Solid {
  translation 0.08 0.09 0.025
  name "zona2_wall_top"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.40 0.40 0.45
        roughness 0.5
        metalness 0.1
      }
      geometry Box {
        size 0.26 0.02 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.26 0.02 0.05
  }
}

# --- Estrechamiento: pared inferior sube a y=-0.09 ---
Solid {
  translation 0.08 -0.09 0.025
  name "zona2_wall_bottom"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.40 0.40 0.45
        roughness 0.5
        metalness 0.1
      }
      geometry Box {
        size 0.26 0.02 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.26 0.02 0.05
  }
}

