#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/gctronic/e-puck/protos/E-puck.proto"

WorldInfo {
  info [
    "Laboratorio 2: Escenario COMPLEJO - laberinto progresivo"
    "Navegacion reactiva con filtrado y fusion de sensores"
    "ICI 4150 - Robotica y Sistemas Autonomos"
  ]
  title "Lab2 - Escenario Complejo: Laberinto Progresivo"
  basicTimeStep 32
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.094
  position 0 0 1.5
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 1 1
  wallHeight 0.05
}
E-puck {
  translation -0.44 0 0
  rotation 0 0 1 0
  name "e-puck"
  controller "lab2_controller"
  customData "complex"
}

# ============================================================
# ESCENARIO COMPLEJO: Laberinto Progresivo (3 zonas)
# Arena 1x1 m. Robot en (-0.44, 0) mirando +X.
# Las paredes se estrechan progresivamente y los obstaculos
# estan desplazados del centro para guiar al robot, no bloquearlo.
# ============================================================

# === PARED EXTERIOR FIJA: y = +0.12 (todo el recorrido) ===
Solid {
  translation 0.0 0.12 0.025
  name "wall_top"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.40 0.40 0.45
        roughness 0.5
        metalness 0.1
      }
      geometry Box {
        size 0.90 0.02 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.90 0.02 0.05
  }
}

# === ZONA 1 (x=-0.44 a -0.10): amplio, 24 cm, pilar guia ===
# Pared inferior zona 1 (y=-0.12)
Solid {
  translation -0.27 -0.12 0.025
  name "z1_wall_bottom"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.40 0.40 0.45
        roughness 0.5
        metalness 0.1
      }
      geometry Box {
        size 0.34 0.02 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.34 0.02 0.05
  }
}
# Pilar desplazado a la derecha (deja paso libre a la izquierda)
Solid {
  translation -0.28 0.04 0.025
  name "z1_pilar"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.90 0.60 0.10
        roughness 0.25
        metalness 0.10
      }
      geometry Cylinder {
        height 0.05
        radius 0.02
      }
    }
  ]
  boundingObject Cylinder {
    height 0.05
    radius 0.02
  }
}

# === ZONA 2 (x=-0.10 a 0.22): medio, 18 cm, dos obstaculos ===
# Pared inferior sube a y=-0.09
Solid {
  translation 0.06 -0.09 0.025
  name "z2_wall_bottom"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.40 0.40 0.45
        roughness 0.5
        metalness 0.1
      }
      geometry Box {
        size 0.32 0.02 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.32 0.02 0.05
  }
}
# Obstaculo izquierdo (deja paso a la derecha)
Solid {
  translation -0.04 -0.03 0.025
  name "z2_obs_izq"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.20 0.50 0.85
        roughness 0.30
        metalness 0.05
      }
      geometry Box {
        size 0.03 0.04 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.03 0.04 0.05
  }
}
# Obstaculo derecho (fuerza correccion fina)
Solid {
  translation 0.12 0.04 0.025
  name "z2_obs_der"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.25 0.20
        roughness 0.30
        metalness 0.05
      }
      geometry Box {
        size 0.03 0.04 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.03 0.04 0.05
  }
}

# === ZONA 3 (x=0.22 a 0.44): estrecho, 14 cm, cierre final ===
# Pared inferior sube a y=-0.07
Solid {
  translation 0.33 -0.07 0.025
  name "z3_wall_bottom"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.35 0.35 0.40
        roughness 0.5
        metalness 0.1
      }
      geometry Box {
        size 0.22 0.02 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.22 0.02 0.05
  }
}
# Pared de cierre (bloquea el final del pasillo)
Solid {
  translation 0.42 0.0 0.025
  name "z3_end"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.70 0.25 0.70
        roughness 0.30
        metalness 0.05
      }
      geometry Box {
        size 0.02 0.10 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.02 0.10 0.05
  }
}
# Pilar de salida (guiando hacia la abertura superior)
Solid {
  translation 0.34 0.18 0.025
  name "z3_salida"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.25 0.80 0.40
        roughness 0.25
        metalness 0.10
      }
      geometry Cylinder {
        height 0.05
        radius 0.02
      }
    }
  ]
  boundingObject Cylinder {
    height 0.05
    radius 0.02
  }
}
