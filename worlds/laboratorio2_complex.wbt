        roughness 0.6
        metalness 0.0
      }
      geometry Box {
        size 0.02 0.20 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.02 0.20 0.05
  }
}

# === TRAMO 3: horizontal superior (con apertura de entrada) ===
# Limites y=0.20 (abajo) y y=0.36 (arriba)
Solid {
  translation 0.30 0.20 0.025
  name "wall_h2_bottom"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.45 0.45 0.50
        roughness 0.6
