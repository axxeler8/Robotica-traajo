# Obstáculo 1: bloque central grande  (0.0, 0.0, 0.25, 0.25)
DEF OBS_1 Solid {
  translation 0.0 0.0 0.05
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.25 0.12
        roughness 0.5
      }
      geometry Box {
        size 0.25 0.25 0.1
      }
    }
  ]
  boundingObject Box {
    size 0.25 0.25 0.1
  }
  name "obstacle_1"
}

