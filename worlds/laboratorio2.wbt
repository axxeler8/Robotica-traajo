#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/gctronic/e-puck/protos/E-puck.proto"

WorldInfo {
  info [
    "Laboratorio 2: Escenario SIMPLE - pocos obstaculos guiados"
    "Navegacion reactiva con filtrado y fusion de sensores"
    "ICI 4150 - Robotica y Sistemas Autonomos"
  ]
  title "Lab2 - Escenario Simple"
  basicTimeStep 32
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.094
  position 0 0 1.2
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 1 1
  wallHeight 0.05
}
E-puck {
  translation -0.35 0 0
  rotation 0 0 1 0
  name "e-puck"
  controller "lab2_controller"
  customData "simple"
}

# ============================================================
# ESCENARIO SIMPLE: pocos obstaculos con trayectorias claras
# Arena 1x1 m. Robot en (-0.35, 0) mirando +X.
# Obstaculo frontal obliga primer giro y dos obstaculos laterales
# fuerzan decision izquierda/derecha con espacio suficiente.
# ============================================================

# --- Obstaculo 1: Muro frontal (bloquea avance directo) ---
Solid {
  translation -0.10 0 0.025
  name "obs1_front_wall"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.2 0.2
        roughness 0.4
        metalness 0.0
      }
      geometry Box {
        size 0.02 0.16 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.02 0.16 0.05
  }
}

# --- Obstaculo 2: Caja lateral izquierda ---
Solid {
  translation 0.12 0.08 0.025
  name "obs2_left"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.5 0.9
        roughness 0.4
        metalness 0.0
      }
      geometry Box {
        size 0.04 0.04 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.04 0.04 0.05
  }
}

# --- Obstaculo 3: Caja lateral derecha ---
Solid {
  translation 0.22 -0.08 0.025
  name "obs3_right"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.8 0.3
        roughness 0.4
        metalness 0.0
      }
      geometry Box {
        size 0.04 0.04 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.04 0.04 0.05
  }
}
