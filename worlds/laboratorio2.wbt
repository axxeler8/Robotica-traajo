#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/gctronic/e-puck/protos/E-puck.proto"

WorldInfo {
  info [
    "Laboratorio 2: Escenario SIMPLE - arena compacta con obstaculos"
    "El robot debe esquivar multiples obstaculos en espacio reducido"
    "ICI 4150 - Robotica y Sistemas Autonomos"
  ]
  title "Lab2 - Escenario Simple"
  basicTimeStep 32
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.094
  position 0 0 1.0
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 0.5 0.5
  wallHeight 0.05
}
E-puck {
  translation -0.15 0 0
  rotation 0 0 1 0
  name "e-puck"
  controller "lab2_controller"
  customData "simple"
}

# ============================================================
# ESCENARIO SIMPLE: Arena compacta 0.5x0.5 m
# Robot en (-0.15, 0) mirando +X. Arena de +-0.25 m.
# Obstaculos distribuidos para forzar multiples evasiones.
# E-puck: ~7 cm diametro; sensores IR rango ~5 cm.
# ============================================================

# --- Obstaculo 1: Muro frontal directo ---
# Bloquea el camino recto del robot, forzando primer giro.
Solid {
  translation 0.0 0 0.025
  name "obs1_wall_front"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.2 0.2
        roughness 0.4
        metalness 0.0
      }
      geometry Box {
        size 0.02 0.18 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.02 0.18 0.05
  }
}

# --- Obstaculo 2: Muro superior ---
# Bloquea si el robot sube tras esquivar obs1.
Solid {
  translation -0.08 0.15 0.025
  name "obs2_top"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.5 0.9
        roughness 0.4
        metalness 0.0
      }
      geometry Box {
        size 0.12 0.02 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.12 0.02 0.05
  }
}

# --- Obstaculo 3: Muro inferior ---
# Bloquea si el robot baja tras esquivar obs1.
Solid {
  translation -0.08 -0.15 0.025
  name "obs3_bottom"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.8 0.3
        roughness 0.4
        metalness 0.0
      }
      geometry Box {
        size 0.12 0.02 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.12 0.02 0.05
  }
}

# --- Obstaculo 4: Cilindro en zona derecha ---
Solid {
  translation 0.12 -0.06 0.025
  name "obs4_cylinder"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.7 0.1
        roughness 0.3
        metalness 0.0
      }
      geometry Cylinder {
        height 0.05
        radius 0.025
      }
    }
  ]
  boundingObject Cylinder {
    height 0.05
    radius 0.025
  }
}

# --- Obstaculo 5: Muro diagonal derecho ---
Solid {
  translation 0.15 0.10 0.025
  name "obs5_right"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.7 0.3 0.7
        roughness 0.4
        metalness 0.0
      }
      geometry Box {
        size 0.02 0.12 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.02 0.12 0.05
  }
}
