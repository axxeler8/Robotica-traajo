#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/gctronic/e-puck/protos/E-puck.proto"

WorldInfo {
  info [
    "Laboratorio 2: Escenario SIMPLE - pocos obstáculos"
    "Navegación reactiva con filtrado y fusión de sensores"
    "ICI 4150 - Robótica y Sistemas Autónomos"
  ]
  title "Lab2 - Escenario Simple"
  basicTimeStep 32
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.094
  position 0 0 2.5
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 2 2
  wallHeight 0.05
}
E-puck {
  translation 0 0 0
  rotation 0 0 1 0
  name "e-puck"
  controller "lab2_controller"
  customData "simple"
}
# ============================================================
# ESCENARIO SIMPLE: Arena abierta con 3 obstaculos dispersos
# Los obstaculos estan en la trayectoria del robot (eje +x)
# pero con suficiente separacion para navegar.
# NOTA: Sensores IR del e-puck tienen rango maximo ~5 cm.
# ============================================================

# Obstaculo 1: Caja centrada al frente (a 12 cm)
Solid {
  translation 0.12 0 0.025
  name "obs1_front"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.3 0.3
        roughness 0.4
        metalness 0.0
      }
      geometry Box {
        size 0.04 0.04 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.04 0.04 0.05
  }
}

# Obstaculo 2: Caja desplazada a la derecha (a 22 cm)
Solid {
  translation 0.22 0.06 0.025
  name "obs2_right"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.3 0.3 0.9
        roughness 0.4
        metalness 0.0
      }
      geometry Box {
        size 0.04 0.04 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.04 0.04 0.05
  }
}

# Obstaculo 3: Cilindro a la izquierda (a 32 cm)
Solid {
  translation 0.32 -0.05 0.025
  name "obs3_left"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.3 0.8 0.3
        roughness 0.4
        metalness 0.0
      }
      geometry Cylinder {
        height 0.05
        radius 0.025
      }
    }
  ]
  boundingObject Cylinder {
    height 0.05
    radius 0.025
  }
}

# Obstaculo 4: Caja al fondo (a 45 cm)
Solid {
  translation 0.45 0 0.025
  name "obs4_far"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.7 0.5 0.2
        roughness 0.4
        metalness 0.0
      }
      geometry Box {
        size 0.05 0.05 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.05 0.05 0.05
  }
}
