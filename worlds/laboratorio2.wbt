WorldInfo {
  info [
    "Laboratorio 2: Escenario SIMPLE - slalom abierto"
    "Navegacion reactiva con filtrado y fusion de sensores"
    "ICI 4150 - Robotica y Sistemas Autonomos"
  ]
  title "Lab2 - Escenario Simple"
  basicTimeStep 32
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.094
  position 0 0 1.2
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 1 1
  wallHeight 0.05
}
E-puck {
  translation -0.42 0 0
  rotation 0 0 1 0
  name "e-puck"
  controller "lab2_controller"
  customData "simple"
}

# ============================================================
# ESCENARIO SIMPLE: slalom abierto con 3 pilares
# Arena 1x1 m. Robot en (-0.42, 0) mirando +X.
# Tres pilares alternados obligan a correcciones suaves de rumbo.
# ============================================================

# --- Pilar 1 (izquierda) ---
Solid {
  translation -0.20 0.06 0.025
  name "pillar_1"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.25 0.25
        roughness 0.35
        metalness 0.0
      }
      geometry Cylinder {
        height 0.05
        radius 0.025
      }
    }
  ]
  boundingObject Cylinder {
    height 0.05
    radius 0.025
  }
}

# --- Pilar 2 (derecha) ---
Solid {
  translation 0.00 -0.06 0.025
  name "pillar_2"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.25 0.45 0.85
        roughness 0.35
        metalness 0.0
      }
      geometry Cylinder {
        height 0.05
        radius 0.025
      }
    }
  ]
  boundingObject Cylinder {
    height 0.05
    radius 0.025
  }
}

# --- Pilar 3 (izquierda) ---
