WorldInfo {
  info [
    "Laboratorio 2: Escenario SIMPLE - slalom de precision"
    "Navegacion reactiva con filtrado y fusion de sensores"
    "ICI 4150 - Robotica y Sistemas Autonomos"
  ]
  title "Lab2 - Escenario Simple: Slalom de Precision"
  basicTimeStep 32
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.094
  position 0 0 1.2
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 1 1
  wallHeight 0.05
}
E-puck {
  translation -0.42 0 0
  rotation 0 0 1 0
  name "e-puck"
  controller "lab2_controller"
  customData "simple"
}

# ============================================================
# ESCENARIO SIMPLE: Slalom de Precision (4 pilares en rombo)
# Arena 1x1 m. Robot en (-0.42, 0) mirando +X.
# Cuatro pilares forman un camino en rombo que el robot debe
# atravesar con precisión. Cada pilar esta colocado de forma
# que los sensores laterales guian naturalmente la trayectoria.
# Diseñado para mostrar navegacion reactiva limpia y elegante.
# ============================================================

# --- Pilar 1 (izquierda): primera correccion ---
Solid {
  translation -0.16 0.05 0.025
  name "pilar_1_izq"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.90 0.25 0.20
        roughness 0.30
        metalness 0.05
      }
      geometry Cylinder {
        height 0.05
        radius 0.025
      }
    }
  ]
  boundingObject Cylinder {
    height 0.05
    radius 0.025
  }
}

# --- Pilar 2 (derecha): segunda correccion ---
Solid {
  translation 0.06 -0.05 0.025
  name "pilar_2_der"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.20 0.50 0.85
        roughness 0.30
        metalness 0.05
      }
      geometry Cylinder {
        height 0.05
        radius 0.025
      }
    }
  ]
  boundingObject Cylinder {
    height 0.05
    radius 0.025
  }
}

