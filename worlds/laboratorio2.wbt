#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/gctronic/e-puck/protos/E-puck.proto"

WorldInfo {
  info [
    "Laboratorio 2: Escenario SIMPLE - compuertas guiadas"
    "Navegacion reactiva con filtrado y fusion de sensores"
    "ICI 4150 - Robotica y Sistemas Autonomos"
  ]
  title "Lab2 - Escenario Simple"
  basicTimeStep 32
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.094
  position 0 0 1.2
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 1 1
  wallHeight 0.05
}
E-puck {
  translation -0.40 0 0
  rotation 0 0 1 0
  name "e-puck"
  controller "lab2_controller"
  customData "simple"
}

# ============================================================
# ESCENARIO SIMPLE: compuertas alternadas + pilar final
# Arena 1x1 m. Robot en (-0.40, 0) mirando +X.
# Dos compuertas obligan a elegir arriba/abajo, luego un pilar
# central fuerza una ultima correccion.
# ============================================================

# --- Comp. 1: bloque inferior (deja paso por arriba) ---
Solid {
  translation -0.18 -0.12 0.025
  name "gate1_bottom"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.25 0.25
        roughness 0.4
        metalness 0.0
      }
      geometry Box {
        size 0.02 0.16 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.02 0.16 0.05
  }
}

# --- Comp. 2: bloque superior (deja paso por abajo) ---
Solid {
  translation 0.02 0.12 0.025
  name "gate2_top"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.25 0.45 0.85
        roughness 0.4
        metalness 0.0
      }
      geometry Box {
        size 0.02 0.16 0.05
      }
    }
  ]
  boundingObject Box {
    size 0.02 0.16 0.05
  }
}

# --- Pilar final (centrado) ---
Solid {
  translation 0.24 0.0 0.025
  name "pillar_final"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.25 0.8 0.4
        roughness 0.35
        metalness 0.0
      }
      geometry Cylinder {
        height 0.05
        radius 0.025
      }
    }
  ]
  boundingObject Cylinder {
    height 0.05
    radius 0.025
  }
}
